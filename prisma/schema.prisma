generator client {
  provider = "prisma-client"
  output   = "../services/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  NORMAL
  RESTRICTED
  BLACKLISTED
}

enum AdminRole {
  OPS
  SUPER_ADMIN
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  LOCKING
  GROUPED
  GROUP_FAILED
  ADDRESS_UNLOCKED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CLOSED
  PAID_PENDING_GROUP
  GROUPED
  GROUP_FAILED
  REFUND_REQUESTED
  REFUND_REVIEWING
  REFUNDING
  REFUNDED
  CANCELED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REVIEWING
  REFUNDING
  SUCCEEDED
  FAILED
  REJECTED
}

enum TableGroupStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELED
}

enum ReportStatus {
  OPEN
  RESOLVED
  REJECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id             String          @id @default(cuid())
  wechatOpenid   String          @unique
  wechatUnionid  String?
  phone          String?
  status         UserStatus      @default(NORMAL)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        UserProfile?
  consents       ConsentRecord[]
  orders         Order[]
  reviews        Review[]
  reports        Report[]
  blacklistEntry Blacklist?
  notifications  Notification[]
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredAreas      String[]
  availableTimes      String[]
  tastePreferences    String[]
  dietaryRestrictions String[]
  budgetRange         String
  tableVibe           String
  acceptableTableSizes Int[]   @default([4, 5, 6, 7, 8])
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id               String   @id @default(cuid())
  userId           String
  agreementVersion String
  source           String
  policyHash       String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agreementVersion])
}

model AgreementPolicy {
  version     String   @id
  text        String
  textHash    String
  source      String
  active      Boolean  @default(false)
  activatedAt DateTime
  createdAt   DateTime @default(now())
}

model AdminUser {
  id        String     @id @default(cuid())
  username  String     @unique
  role      AdminRole
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  audits    AuditLog[]
}

model Restaurant {
  id           String           @id @default(cuid())
  name         String
  district     String
  businessArea String
  address      String
  contactName  String
  contactPhone String
  budgetCents  Int
  cuisineTags  String[]
  capacity     Int
  status       RestaurantStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  activities   Activity[]
}

model Activity {
  id                String        @id @default(cuid())
  restaurantId      String
  title             String
  theme             String
  description       String
  district          String
  businessArea      String
  startsAt          DateTime
  endsAt            DateTime
  registrationEndsAt DateTime
  serviceFeeCents   Int
  mealFeeIncluded   Boolean       @default(false)
  mealFeePolicyText String
  minSize           Int           @default(4)
  targetSize        Int           @default(6)
  maxSize           Int           @default(8)
  capacity          Int
  status            ActivityStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id])
  orders            Order[]
  notifications     Notification[]
  tableGroups       TableGroup[]

  @@index([status, startsAt])
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  activityId      String
  amountCents     Int
  status          OrderStatus  @default(PENDING_PAYMENT)
  agreementVersion String
  consentRecordId String?
  profileSnapshot Json?
  inventoryLockedUntil DateTime?
  registrationActive Boolean @default(true)
  capacityHeld Boolean @default(true)
  version         Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id])
  activity        Activity     @relation(fields: [activityId], references: [id])
  payments        Payment[]
  refunds         Refund[]
  review          Review?
  reports         Report[]
  tableMembers    TableMember[]
  receipts        ChannelReceipt[]
  refundObligations RefundObligation[]
  notifications     Notification[]

  // The persistent active-registration partial unique index is maintained by migration SQL.
  @@index([userId, activityId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  merchantOrderNo String        @unique @default(cuid())
  amountCents    Int
  status         PaymentStatus @default(PENDING)
  channel        String        @default("mock")
  active         Boolean       @default(true)
  resolutionState String       @default("NEW")
  version        Int           @default(0)
  merchantScope  String        @default("legacy-unverified")
  providerConfigId String      @default("legacy-unverified")
  nextQueryAt    DateTime?
  prepayId       String?       @unique
  channelTradeNo String?       @unique
  callbackNonce  String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id])

  receipts       ChannelReceipt[]
  refunds        Refund[]

  @@index([orderId, status])
}

model Refund {
  id              String       @id @default(cuid())
  orderId         String
  merchantRefundNo String      @unique @default(cuid())
  paymentId       String?
  receiptId       String?
  obligationId    String?       @unique
  channel         String        @default("legacy-unverified")
  merchantScope   String        @default("legacy-unverified")
  providerConfigId String       @default("legacy-unverified")
  resolutionState String        @default("NEW")
  version         Int           @default(0)
  amountCents     Int
  status          RefundStatus @default(REVIEWING)
  reason          String
  requestedBy     String
  channelRefundNo String?      @unique
  callbackNonce   String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id])

  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  receipt         ChannelReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  obligation      RefundObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
}

model TableGroup {
  id          String           @id @default(cuid())
  activityId  String
  status      TableGroupStatus @default(PENDING_CONFIRMATION)
  generation  Int              @default(0)
  ordinal     Int?
  candidateDigest String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  activity    Activity         @relation(fields: [activityId], references: [id])
  members     TableMember[]

  @@unique([activityId, generation, ordinal])
}

model TableMember {
  id           String     @id @default(cuid())
  tableGroupId String
  orderId      String
  createdAt    DateTime   @default(now())
  tableGroup   TableGroup @relation(fields: [tableGroupId], references: [id], onDelete: Cascade)
  order        Order      @relation(fields: [orderId], references: [id])

  @@unique([tableGroupId, orderId])
}

model Report {
  id        String       @id @default(cuid())
  userId    String
  orderId   String
  type      String
  content   String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id])
  order     Order        @relation(fields: [orderId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  orderId   String   @unique
  score     Int
  tags      String[]
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
}

model Blacklist {
  id        String   @id @default(cuid())
  userId    String   @unique
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String     @id @default(cuid())
  actorId   String?
  actorRole AdminRole?
  action    String
  targetType String
  targetId  String
  reason    String?
  metadata  Json?
  createdAt DateTime   @default(now())
  actor     AdminUser? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
}

model Notification {
  id        String             @id @default(cuid())
  businessKey String?          @unique
  userId    String
  orderId   String?
  activityId String?
  type      String
  status    NotificationStatus @default(PENDING)
  payload   Json?
  readAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  activity  Activity?          @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt, id])
}

model WorkerHeartbeat {
  id          String   @id @default(cuid())
  mode        String
  instanceId  String
  version     String
  lastPolledAt DateTime @default(now())

  @@unique([mode, instanceId])
  @@index([mode, lastPolledAt])
}


model ChannelReceipt {
  id               String   @id @default(cuid())
  channel          String
  merchantScope    String
  channelTradeNo   String
  merchantOrderNo  String
  paymentId        String?
  orderId          String?
  amountCents      Int
  currency         String   @default("CNY")
  evidenceHash     String
  verifiedAt       DateTime
  paidAt           DateTime?
  createdAt        DateTime @default(now())
  payment          Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds          Refund[]
  obligations      RefundObligation[]

  @@unique([channel, merchantScope, channelTradeNo])
  @@index([merchantScope, merchantOrderNo])
}

model RefundObligation {
  id            String @id @default(cuid())
  receiptId     String
  orderId       String?
  businessKey   String @unique
  cause         String
  amountCents   Int
  state         String @default("OPEN")
  owner         String
  deadline      DateTime
  policyVersion String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  receipt       ChannelReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  order         Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refund        Refund?
}

model ReceivedEvent {
  id                     String @id @default(cuid())
  source                 String
  merchantScope          String
  eventKey               String
  payloadHash            String
  normalizedPayload      Json
  verificationMaterialId String
  verifiedAt             DateTime
  state                  String @default("RECEIVED")
  createdAt              DateTime @default(now())

  @@unique([source, merchantScope, eventKey])
}

model DurableJob {
  id             String @id @default(cuid())
  kind           String
  businessKey    String @unique
  payloadVersion Int @default(1)
  refId          String
  state          String @default("READY")
  runAt          DateTime @default(now())
  attempts       Int @default(0)
  leaseOwner     String?
  leaseUntil     DateTime?
  generation     Int @default(0)
  errorClass     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([state, runAt])
}

model ReconciliationBatch {
  id             String @id @default(cuid())
  merchantScope  String
  period         String
  sourceHash     String
  coverageState  String
  decisionOrdinal BigInt @default(autoincrement())
  createdAt      DateTime @default(now())

  @@unique([merchantScope, period, sourceHash])
}

model FinancialCase {
  id             String @id @default(cuid())
  caseKey        String @unique
  category       String
  sourceRef      String
  owner          String
  deadline       DateTime
  state          String @default("OPEN")
  resolution     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([state, deadline])
}

// Disposable mock channel facts survive API/worker restarts and never represent real funds.
model MockChannelTransaction {
  id              String @id @default(cuid())
  kind            String
  businessKey     String @unique
  channelNo       String @unique
  originalTradeNo String?
  amountCents     Int
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
