# Runtime
NODE_ENV=development
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai

# API
API_BASE_URL=http://localhost:3000
API_PORT=3000
SESSION_COOKIE_NAME=
SESSION_SECRET=

# Database
DATABASE_URL=postgresql://timeleft:timeleft_dev_password@localhost:5432/timeleft_shanghai?schema=public

# Cache / Jobs
REDIS_URL=
JOB_WORKER_ENABLED=false

# WeChat Mini Program Auth / Phone
AUTH_PROVIDER=mock
PHONE_PROVIDER=mock
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_LOGIN_MOCK_ENABLED=true
WECHAT_PHONE_MOCK_ENABLED=true

# WeChat Pay Provider Boundary
PAYMENT_PROVIDER=mock
REFUND_PROVIDER=mock
WECHAT_PAY_ENABLED=false
ALLOW_MOCK_PAYMENT_IN_PRODUCTION=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_CALLBACK_URL=
WECHAT_REFUND_CALLBACK_URL=

# Map / Navigation
MAP_PROVIDER=wechat
MAP_API_KEY=

# Notifications
NOTIFICATION_MODE=in_app
WECHAT_SUBSCRIBE_MESSAGE_ENABLED=false

# Security / Compliance
FORBIDDEN_WORD_SCAN_ENABLED=true
AUDIT_LOG_REQUIRED=true
PII_LOG_MASKING_ENABLED=true

# Feature Flags
FEATURE_REAL_WECHAT_PAY=false
FEATURE_WECHAT_SUBSCRIBE_MESSAGE=false
FEATURE_AUTO_ADDRESS_UNLOCK=false
FEATURE_MERCHANT_PORTAL=false
